# Frontend build-time configuration (Vite inlines VITE_* vars at build).
#
# VITE_API_BASE — origin of the deployed backend API.
#   Local dev can leave this blank: vite.config.js proxies /api -> localhost:8000.
#   Production MUST set it (e.g. in Vercel project settings), otherwise same-origin
#   /api/* requests are served the SPA index.html by the catch-all rewrite and every
#   API call silently fails. No trailing slash.
VITE_API_BASE=https://hillingone-api.onrender.com
